# ---------------------------------------------------------------------
# Chép tệp này thành .env rồi điền giá trị thật.
# KHÔNG commit tệp .env lên kho mã.
# ---------------------------------------------------------------------

# Chuỗi kết nối PostgreSQL.
# Dùng được với Postgres cài ở máy lẫn Postgres có sẵn trên các nền tảng
# triển khai — chỉ cần đổi chuỗi này, không phải sửa mã.
#   ở máy  : postgresql://postgres:matkhau@localhost:5432/tramtrack
#   trên mây: lấy chuỗi nền tảng cấp, thường có dạng postgresql://...?sslmode=require
DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/tramtrack

# Đặt false khi chạy Postgres ở máy (không có SSL). Trên mây thì bỏ dòng này.
DATABASE_SSL=false

PORT=3000

# Địa chỉ gốc in lên mã QR của con tem.
#
#   !!  GIÁ TRỊ NÀY ĐI VÀO MÃ QR VÀ KHÔNG SỬA ĐƯỢC SAU KHI IN.
#   !!  Chốt tên miền TRƯỚC khi chạy scripts/mint.js.
#
PUBLIC_BASE_URL=https://tramtrack.vn

# Cho phép frontend gọi API. Nhiều địa chỉ thì ngăn cách bằng dấu phẩy.
# Khi triển khai thật thì thay * bằng đúng tên miền của frontend.
CORS_ORIGIN=*


# ---------------------------------------------------------------------
# Khoá ký phiếu đăng nhập. BẮT BUỘC, phải từ 32 ký tự trở lên.
# Sinh một chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Khi triển khai thật phải đặt khoá KHÁC với lúc chạy ở máy.
# ---------------------------------------------------------------------
TOKEN_SECRET=

# Số giờ phiếu đăng nhập còn hiệu lực.
TOKEN_HAN_GIO=12

# Chỉ dùng cho npm run test:api — tài khoản tạo bởi npm run tao-nguoi-dung.
TEST_EMAIL=
TEST_MAT_KHAU=
